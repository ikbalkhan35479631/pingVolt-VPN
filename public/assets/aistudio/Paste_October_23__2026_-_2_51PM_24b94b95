EJEMPLO 2: COLA CONCURRENTE LIBRE DE BLOQUEOS EN C++ (C++20 Atomics)
PROMPT: Construye una cola MPSC (Múltiples Productores, Un Consumidor) libre de bloqueos para producción en C++20 moderno utilizando operaciones atómicas, semántica de ordenamiento de memoria y relleno de líneas de caché (cache-line padding) para eliminar el false sharing.
CÓDIGO:
──────────────────────────────────────────────────────────────────────────────
#include <atomic>
#include <memory>
#include <optional>
#include <iostream>
#include <thread>
#include <vector>
template<typename T>
class MPSCQueue {
private:
    struct Node {
        std::atomic<Node*> next{nullptr};
        alignas(64) T data; // payload alineado a la línea de caché
        explicit Node(T val) : data(std::move(val)) {}
        Node() = default; // constructor centinela
    };
    // Líneas de caché separadas: previene el false sharing entre productores/consumidor
    alignas(64) std::atomic<Node*> head_; // el consumidor lee aquí
    alignas(64) std::atomic<Node*> tail_; // los productores añaden aquí
public:
    MPSCQueue() {
        Node* sentinel = new Node();
        head_.store(sentinel, std::memory_order_relaxed);
        tail_.store(sentinel, std::memory_order_relaxed);
    }
    ~MPSCQueue() {
        while (auto val = dequeue()) {} // vacía los elementos restantes
        delete head_.load(std::memory_order_relaxed); // libera el centinela
    }
    // Thread-safe: múltiples productores pueden llamar simultáneamente
    void enqueue(T value) {
        Node* node = new Node(std::move(value));
        Node* prev = tail_.exchange(node, std::memory_order_acq_rel);
        prev->next.store(node, std::memory_order_release);
    }
    // Solo un único consumidor
    std::optional<T> dequeue() {
        Node* head = head_.load(std::memory_order_relaxed);
        Node* next = head->next.load(std::memory_order_acquire);
        if (!next) return std::nullopt;
        
        head_.store(next, std::memory_order_relaxed);
        T value = std::move(next->data);
        delete head; // libera el antiguo centinela
        return value;
    }
};
int main() {
    MPSCQueue<int> queue;
    constexpr int ITEMS_PER_PRODUCER = 100'000;
    constexpr int NUM_PRODUCERS = 4;
    std::atomic<int> total_produced{0};
    
    std::vector<std::thread> producers;
    for (int p = 0; p < NUM_PRODUCERS; ++p) {
        producers.emplace_back([&, p] {
            for (int i = 0; i < ITEMS_PER_PRODUCER; ++i)
                queue.enqueue(p * ITEMS_PER_PRODUCER + i);
            total_produced.fetch_add(ITEMS_PER_PRODUCER, std::memory_order_relaxed);
        });
    }
    int consumed = 0;
    while (consumed < NUM_PRODUCERS * ITEMS_PER_PRODUCER) {
        if (auto val = queue.dequeue()) ++consumed;
    }
    for (auto& t : producers) t.join();
    std::cout << "Successfully consumed " << consumed << " items.\n";
    return 0;
}
